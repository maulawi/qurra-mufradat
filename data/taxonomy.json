  "display_policy": {
    "_comment": "What a learner sees per layer and status. show = plain (provisional glosses and morphology rely on the page-level prototype banner and the Source information panel); show_with_badge = shown with an inline 'provisional' label (roots, conjugation); under_review = the field is replaced by an 'under review' note; not_applicable = replaced by a neutral 'none for this kind of word' note; hide = nothing. Change a value here and rebuild to change the whole app.",
    "root": {
      "verified": "show", "reviewed": "show", "provisional": "show_with_badge",
      "imported": "hide", "draft": "hide", "disputed": "under_review", "unresolved": "under_review", "null_policy": "not_applicable"
    },
    "gloss": {
      "verified": "show", "reviewed": "show", "provisional": "show", "imported": "show", "draft": "hide",
      "disputed": "hide", "unresolved": "hide", "null_policy": "hide"
    },
    "conjugation": {
      "verified": "show", "reviewed": "show", "provisional": "show_with_badge", "imported": "hide", "draft": "hide",
      "disputed": "hide", "unresolved": "hide", "null_policy": "hide"
    },
    "morphology": {
      "verified": "show", "reviewed": "show", "provisional": "show", "imported": "show", "draft": "hide",
      "disputed": "hide", "unresolved": "hide", "null_policy": "hide"
    }
  },

  "review_gate": {
    "_comment": "Encodes the structural part of the root production gate. A root assignment with one of these statuses must carry evidence and a reviewer; one with a 'must_be_null' status must not carry a root value.",
    "root_requires_evidence": ["reviewed", "verified"],
    "root_must_be_null": ["disputed", "unresolved", "null_policy"]
  }
